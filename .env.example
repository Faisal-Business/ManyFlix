# Public site URL used for SEO metadata and sitemap generation.
# Replace this reserved example URL with your own production domain.
VITE_SITE_URL=https://manyflix.example

# TMDB API key for catalog metadata, recommendations, and sitemap generation.
# Vite variables are public in the browser bundle; use a restricted key.
VITE_TMDB_API_KEY=

# Playback service origin. Replace with the Any player service URL.
VITE_PLAYER_BASE_URL=https://vidly.pro/
